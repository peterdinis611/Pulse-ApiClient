{
  "name": "api-client",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "docs:sync": "bun scripts/sync-docs.ts",
    "docs:dev": "bun scripts/sync-docs.ts && bun run --cwd docs/site dev",
    "docs:build": "bun scripts/sync-docs.ts && bun run --cwd docs/site build",
    "pulse:cli": ".venv/bin/python python/pulse_cli.py",
    "pulse:cli:install": "bun scripts/ensure-pulse-cli.ts --require",
    "pulse:cli:test": "python3 -m unittest discover -s python/tests -p 'test_*.py'",
    "pulse:cli:demo": ".venv/bin/python python/pulse_cli.py openapi python/examples/openapi.json --out python/examples/.out/from-openapi.json && .venv/bin/python python/pulse_cli.py har python/examples/capture.har --out python/examples/.out/from-har.json && .venv/bin/python python/pulse_cli.py schema python/examples/body.json python/examples/schema.json && .venv/bin/python python/pulse_cli.py interpolate '{{baseUrl}}/{{id}}' --env-file python/examples/staging.env --var id=1 && .venv/bin/python python/pulse_cli.py test python/examples/script.js python/examples/response.json"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-pacer": "^0.22.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5",
    "xstate": "^5.32.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/xlsx": "^0.0.36",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
